# 星屿积分截图识别环境变量（复制为 .env 后填写）
# OpenAI API Key，仅服务端读取，浏览器不接触
OPENAI_API_KEY=
# OpenAI 兼容接口地址；本地 Ollama 使用 http://127.0.0.1:11434/v1
OPENAI_BASE_URL=
# 视觉模型名称，默认 gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Tencent COS media storage (server only)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_CDN_BASE_URL=
# Node 启动不会自动发布公开配置；后台保存或识别提交时才同步 config/site-config.js
# GitHub Pages 构建时使用的公开配置脚本地址（不填在本地 .env 也可以）
VITE_PUBLIC_CONFIG_SCRIPT_URL=
